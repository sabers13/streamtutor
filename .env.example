# StreamTutor Environment Configuration
# Default mode is 100% offline & free with zero API keys required!

# Server Host & Port
HOST=127.0.0.1
PORT=8000

# Analyzer Provider: "deterministic" (offline rule engine, default) or "opencode" / "deepseek" / "gemini"
ANALYZER_PROVIDER=deterministic

# Optional: AI Provider Key (Only needed if ANALYZER_PROVIDER is set to an AI engine)
# OPENCODE_API_KEY=your_opencode_api_key_here
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# GEMINI_API_KEY=your_gemini_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default Learner Settings
DEFAULT_USER_LEVEL=A2
DEFAULT_THRESHOLD=B1
